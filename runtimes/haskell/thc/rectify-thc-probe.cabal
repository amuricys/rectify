cabal-version: 2.4
name: rectify-thc-probe
version: 0.1.0.0
build-type: Simple
synopsis: Geometry compatibility probe for native GHC and THC

executable geometry-probe
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends: base >= 4.14 && < 5, rectify-kernels
